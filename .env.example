# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://chess:chess@localhost:54329/chess_trainer
# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://chess:chess@localhost:54329/chess_trainer_test

# --- Stockfish ------------------------------------------------------------
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
# Speed-only settings: they are NOT part of the eval-cache fingerprint.
ENGINE_THREADS=2
ENGINE_HASH_MB=128
# Optional custom NNUE network. Changes evaluations, so it IS fingerprinted.
# ENGINE_EVAL_FILE=
ANALYSIS_DEPTH=16
# Depth for puzzle validation; defaults to ANALYSIS_DEPTH when unset.
# PUZZLE_DEPTH=18
# Depth for scoring moves live and for the engine's replies ("keep playing"
# after a puzzle); defaults to ANALYSIS_DEPTH when unset.
# LIVE_DEPTH=14

# --- Move classification (win-probability points lost, 0-100 scale) --------
INACCURACY_THRESHOLD=5
MISTAKE_THRESHOLD=10
BLUNDER_THRESHOLD=15

# --- Time pressure: clock below min(SECONDS, FRACTION * base time) ---------
TIME_PRESSURE_SECONDS=30
TIME_PRESSURE_FRACTION=0.1

# --- Puzzle generation ----------------------------------------------------
PUZZLE_UNIQUENESS_GAP=15
PUZZLE_MIN_RESULT_WIN_PCT=50
PUZZLE_MAX_PLIES=10
PUZZLE_CRUSHING_WIN_PCT=85
PUZZLE_ADVANTAGE_WIN_PCT=65

# --- HTTP clients ---------------------------------------------------------
HTTP_USER_AGENT=chess-trainer/0.1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# --- Worker ---------------------------------------------------------------
WORKER_POLL_SECONDS=1.0
# Automatic sync: import and analyze new games of every account that has
# been imported before, this often (minutes; 0 turns it off). At most
# AUTO_SYNC_MAX_GAMES per sync.
AUTO_SYNC_MINUTES=15
AUTO_SYNC_MAX_GAMES=100

# --- Lichess puzzle database: URL or local path (.csv or .csv.zst) ---------
# Quality floor: net player vote (-100..100) and number of plays.
PUZZLE_LIBRARY_SOURCE=https://database.lichess.org/lichess_db_puzzle.csv.zst
PUZZLE_LIBRARY_MIN_POPULARITY=50
PUZZLE_LIBRARY_MIN_PLAYS=50
PUZZLE_LIBRARY_BATCH_SIZE=2000

# --- Personal training: recommended Lichess puzzles ------------------------
# Puzzle rating (Glicko-1): starting point without rated games, starting and
# minimum deviation, and the offset added to Chess.com game ratings.
PUZZLE_RATING_DEFAULT=1500
PUZZLE_RATING_INITIAL_DEVIATION=250
PUZZLE_RATING_MIN_DEVIATION=70
PUZZLE_RATING_CHESSCOM_OFFSET=200
# Recommended puzzles are rated within this many points of you (widening if
# too few match); the profile uses this many recent mistakes and blunders.
TRAINING_RATING_WINDOW=100
TRAINING_MISTAKE_SAMPLE=600
